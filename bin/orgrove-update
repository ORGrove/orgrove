#!/bin/sh
# Take a newer ORGrove release into this install as a pull request you merge (plan phase C4).
cd "$(dirname "$0")/.." || exit 1
for py in python3.14 python3.13 python3.12 python3.11 python3; do
  if command -v "$py" >/dev/null 2>&1 && "$py" -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; then
    exec "$py" -m orgrove.update --root "$PWD" "$@"
  fi
done
echo "ORGrove needs Python 3.11 or newer: https://www.python.org/downloads/" >&2
exit 1
