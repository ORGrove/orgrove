#!/bin/sh
# Start the local ORGrove Office (#8). Needs Python 3.11+ and a logged-in `gh`.
cd "$(dirname "$0")/.." || exit 1
for py in python3.14 python3.13 python3.12 python3.11 python3; do
  if command -v "$py" >/dev/null 2>&1 && "$py" -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; then
    exec "$py" -m orgrove.office "$@"
  fi
done
echo "ORGrove Office needs Python 3.11 or newer (Mac: brew install python@3.12; Ubuntu 22.04: sudo apt install python3.11)." >&2
exit 1
