#!/bin/sh
# Clone the ledger branch into $ORGROVE_LEDGER_DIR with the ledger token in $LTOK (#125).
# A freshly minted App token sometimes gets "repository not found" (HTTP 404) for a few seconds,
# so retry 3 times (10 s, then 20 s) before failing the run. The token is never echoed.
set -u
repo="$1"
for try in 1 2 3; do
  rm -rf "$ORGROVE_LEDGER_DIR"
  if git clone -q -b ledger "https://x-access-token:${LTOK}@github.com/${repo}.git" "$ORGROVE_LEDGER_DIR"; then
    [ "$try" -gt 1 ] && echo "::notice::ledger clone succeeded on try $try of 3"
    # the App's bot from config/org.toml (#159)
    git -C "$ORGROVE_LEDGER_DIR" config user.name "$(python -m orgrove.org | sed -n 's/^bot_login=//p')"
    git -C "$ORGROVE_LEDGER_DIR" config user.email "$(python -m orgrove.org | sed -n 's/^bot_email=//p')"
    exit 0
  fi
  [ "$try" -eq 3 ] && break
  echo "::warning::ledger clone failed (try $try of 3); retrying in $((try * 10)) s"
  sleep $((try * 10))
done
echo "::error::ledger clone failed 3 times; see #125"
exit 1
